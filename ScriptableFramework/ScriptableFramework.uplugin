{
	"FileVersion": 3,
	"Version": 2,
	"VersionName": "2.0",
	"FriendlyName": "Scriptable Framework",
	"Description": "Data-driven logic system for Unreal Engine. Designers and programmers compose modular logic sequences (Actions), validation rules (Requirements) and event-driven visual Scriptable Graphs, and embed them directly into Actors, Data Assets, or any UObject. Includes automatic property bindings, reusable assets, mutable Locals, and a full node-graph editor with live debugging, without the overhead of a unique Blueprint graph per interaction.",
	"Category": "Scripting",
	"CreatedBy": "kirzo",
	"CreatedByURL": "https://kirzo.dev",
	"DocsURL": "https://github.com/kirzo/ScriptableFramework",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": true,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "ScriptableFramework",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "ScriptableFrameworkConverters",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "ScriptableFrameworkUncooked",
			"Type": "UncookedOnly",
			"LoadingPhase": "Default"
		},
		{
			"Name": "ScriptableFrameworkEditor",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "PropertyAccessEditor",
			"Enabled": true
		},
		{
			"Name": "PropertyBindingUtils",
			"Enabled": true
		},
		{
			"Name": "DataValidation",
			"Enabled": true
		},
		{
			"Name": "KzLib",
			"Enabled": true
		}
	]
}
